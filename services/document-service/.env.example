# "development" (default if unset) only warns about insecure secrets below.
# "production" makes the service refuse to start if any of them are missing
# or still set to a known-insecure/placeholder value — see
# app/core/secrets_check.py.
ENVIRONMENT=development

# Local dev convenience default matches infra/docker-compose.yml's own
# POSTGRES_PASSWORD fallback. Use a real, unique password in production.
DATABASE_URL=postgresql://docmgmt:docmgmt@postgres:5432/docmgmt

CATALOGUE_SERVICE_URL=http://catalogue-service:8000

# Local dev convenience default — MUST match infra/docker-compose.yml's
# nginx service (INTERNAL_SHARED_SECRET, which its entrypoint renders
# into nginx.conf.template) and catalogue-service/search-service's own
# INTERNAL_SHARED_SECRET (their direct calls to this service carry it
# too — see their app/core/document_client.py). NOT a usable production
# secret — app/core/secrets_check.py rejects this exact value when
# ENVIRONMENT=production. Use a real, unique value (matching everywhere
# it's referenced) in production.
INTERNAL_SHARED_SECRET=local_dev_internal_secret_change_me

MEILI_URL=http://meilisearch:7700
# Local dev convenience default — MUST match MEILI_MASTER_KEY on the
# meilisearch container itself (infra/docker-compose.yml) and every
# other service's .env, or Meilisearch calls fail with an auth error.
# NOT a usable production secret — app/core/secrets_check.py rejects
# this exact value when ENVIRONMENT=production. Use a real, unique key
# (and update it everywhere it's referenced) in production.
MEILI_MASTER_KEY=local_dev_master_key_change_me

SUPPLIER_NAME=Trustwell International Co., Ltd.
SUPPLIER_POSITION=Director
SUPPLIER_ADDRESS=
SUPPLIER_CONTACT=
SUPPORT_EMAIL=
SUPPORT_PHONE=

MINIO_ENDPOINT=minio:9000
# Local dev convenience defaults — MUST match MINIO_ROOT_USER/
# MINIO_ROOT_PASSWORD on the minio container itself (infra/docker-
# compose.yml), or every MinIO call fails with InvalidAccessKeyId. NOT
# usable production credentials — app/core/secrets_check.py rejects
# "minioadmin" when ENVIRONMENT=production. Use real, unique values
# (matching on both sides) in production.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false
# Routed through Nginx (infra/nginx/nginx.conf's /documents/ location) —
# NOT MinIO's own port, which is not published to the host.
MINIO_PUBLIC_ENDPOINT=localhost:8080
