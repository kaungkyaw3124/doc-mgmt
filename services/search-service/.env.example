# "development" (default if unset) only warns about insecure secrets below.
# "production" makes the service refuse to start if any of them are missing
# or still set to a known-insecure/placeholder value — see
# app/core/secrets_check.py.
ENVIRONMENT=development

MEILI_URL=http://meilisearch:7700
# Placeholder only — NOT a usable production secret. Must match the
# MEILI_MASTER_KEY set on the meilisearch container itself and every
# other service's .env.
MEILI_MASTER_KEY=GENERATE_A_SECURE_SECRET
