# "development" (default if unset) only warns about insecure secrets below.
# "production" makes the service refuse to start if any of them are missing
# or still set to a known-insecure/placeholder value — see
# app/core/secrets_check.py.
ENVIRONMENT=development

# Local dev convenience default matches infra/docker-compose.yml's own
# POSTGRES_PASSWORD fallback. In production, use a real, unique password —
# a default/guessable one here fails startup when ENVIRONMENT=production.
DATABASE_URL=postgresql://docmgmt:docmgmt@postgres:5432/auth

SEED_ADMIN_USERNAME=admin
# Placeholder only — NOT a usable production credential (see
# app/core/secrets_check.py: GENERIC_PLACEHOLDERS). Change before first
# boot in production; you can also change the admin password after login.
SEED_ADMIN_PASSWORD=CHANGE_ME

# Placeholder only — NOT a usable production secret. Generate a real one,
# e.g.: openssl rand -hex 32
JWT_SECRET=GENERATE_A_SECURE_SECRET
JWT_ALGORITHM=HS256
# Short-lived on purpose — the browser keeps this only in memory, never
# localStorage; POST /refresh (via the HttpOnly cookie below) transparently
# renews it, so a short lifetime here costs nothing in UX.
JWT_EXPIRE_MINUTES=15

# How long the HttpOnly refresh-token cookie is valid for. Each use
# rotates it (single-use) — see app/core/refresh_tokens.py.
REFRESH_TOKEN_EXPIRE_DAYS=14
