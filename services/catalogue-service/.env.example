# "development" (default if unset) only warns about insecure secrets below.
# "production" makes the service refuse to start if any of them are missing
# or still set to a known-insecure/placeholder value — see
# app/core/secrets_check.py.
ENVIRONMENT=development

# Local dev convenience default matches infra/docker-compose.yml's own
# POSTGRES_PASSWORD fallback. Use a real, unique password in production.
DATABASE_URL=postgresql://docmgmt:docmgmt@postgres:5432/catalogue

MEILI_URL=http://meilisearch:7700
# Placeholder only — NOT a usable production secret. Must match the
# MEILI_MASTER_KEY set on the meilisearch container itself (see
# infra/docker-compose.yml) and every other service's .env.
MEILI_MASTER_KEY=GENERATE_A_SECURE_SECRET

MINIO_ENDPOINT=minio:9000
# Routed through Nginx (infra/nginx/nginx.conf's /products/ location) —
# NOT MinIO's own port, which is not published to the host.
MINIO_PUBLIC_ENDPOINT=localhost:8080
# Placeholders only — NOT usable production credentials. Must match the
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD set on the minio container itself.
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=products
MINIO_SECURE=false
